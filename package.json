{
  "name": "qublack",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "\u9ee2\u9ed1 Qu Black \u2014 a strict 2:1 bilingual programming font family (SIL OFL 1.1)",
  "license": "OFL-1.1",
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "check": "bun run lint && bun run typecheck && bun test src && echo 'check: ok'",
    "fonts:build": "python3 tools/build_all.py",
    "fonts:vf": "python3 tools/build_vf.py --sources sources/upstream --out fonts/vf",
    "fonts:probe": "bun run tools/font-probe.ts fonts/ttf/",
    "fonts:weight": "python3 tools/cjk_weight.py --check fonts/ttf/",
    "fonts:gate": "bash tools/ci-gate.sh",
    "fonts:verify": "python3 tools/verify_family.py fonts/ttf/ --against reference/baseline-v2.json",
    "fonts:audit": "python3 tools/name_audit.py --strict fonts/ttf/",
    "fonts:web": "python3 tools/web_fonts.py --out site/public/fonts --css site/src/styles/qublack-fonts.css",
    "fonts:web:check": "python3 tools/web_fonts.py --check --out site/public/fonts --css site/src/styles/qublack-fonts.css",
    "fonts:release": "python3 tools/pack_release.py --tag v1.3.0",
    "fonts:symbols": "python3 tools/symbol_audit.py --check",
    "fonts:at": "python3 tools/check_at.py",
    "metrics": "python3 tools/metrics_json.py --out site/src/data/metrics.generated.json fonts/ttf/"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/bun": "latest",
    "typescript": "^5.9.0",
    "puppeteer-core": "^24.0.0"
  }
}
