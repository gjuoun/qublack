---
interface Props {
  base: string;
  repo: string;
}
const { base, repo } = Astro.props;
const link = "text-bf-blue no-underline transition-colors duration-200 hover:text-bf-lime";
---

<footer
  class="border-t border-bf-border bg-linear-to-b/srgb from-bf-border-muted/20 to-bf-border-muted/85"
>
  <div class="bf-wrap flex flex-wrap items-start justify-between gap-8 pt-10 pb-12">
    <div>
      <div class="flex items-center gap-[0.7rem] font-display font-bold">
        <span
          class="grid size-10 place-items-center rounded-[11px] bg-bf-border-muted font-code text-[1.15rem] text-bf-blue shadow-[0_0_0_1px_var(--bf-selection)]"
          aria-hidden="true">黢</span
        >
        黢黑 QuBlack
      </div>
      <p class="mt-[0.6rem] mb-0 max-w-[36ch] text-[0.85rem] text-bf-dim">
        Two families, eight faces, one measured 2:1 grid. Hanzi from Source Han Sans via Sarasa,
        Latin from Recursive Linear — SIL OFL 1.1 throughout.
      </p>
    </div>
    <nav aria-label="Footer" class="flex flex-wrap gap-x-6 gap-y-[0.6rem] text-[0.88rem]">
      <a class={link} href={`${base}/#specimen`}>Specimen</a>
      <a class={link} href={`${base}/#grid`}>2:1 grid</a>
      <a class={link} href={`${base}/#download`}>Download</a>
      <a class={link} href={`${repo}/releases`}>Releases</a>
      <a class={link} href={repo}>GitHub</a>
      <a class={link} href={`${repo}/blob/main/LICENSE`}>OFL 1.1</a>
    </nav>
  </div>
</footer>
