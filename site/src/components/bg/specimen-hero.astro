---
import { MONO, SANS } from "../../data/metrics.ts";
import { RELEASE_URL } from "../../data/site.ts";
import BGAgentChat from "./agent-chat.astro";
import { BGButton } from "./button.tsx";
import BGEyebrow from "./eyebrow.astro";

interface Props {
  version: string;
}
const { version } = Astro.props;
const stats = [
  { value: MONO.ratio.toFixed(3), label: "汉 / ASCII ratio" },
  { value: `${MONO.upm} / ${SANS.upm}`, label: "upm Mono / Sans" },
  { value: "8", label: "faces shipped" },
  { value: "OFL 1.1", label: "licence" },
];
---

<section id="specimen" class="scroll-mt-24 pt-[clamp(1.5rem,5vw,3.5rem)] pb-6">
  <div class="bf-wrap" data-reveal>
    <div
      class="bf-cols-xl"
      data-two-column
    >
      <div>
        <BGEyebrow>A modern font for your agent · v{version}</BGEyebrow>

        <h1
          class="mt-[0.6rem] mb-[0.4rem] text-[clamp(3.2rem,7vw,5.2rem)] font-extrabold tracking-[-0.035em]"
        >
          <span class="bf-grad">黢黑</span>
          <span class="text-foreground">Qu Black</span>
        </h1>

        <p class="bf-lead">
          Your agent answers in English, 中文 and code — in the same message. Qu Black renders all
          three on one grid: <strong class="text-foreground">Qu Black Mono</strong> keeps a
          measured <strong class="text-foreground">2:1</strong> cell (汉 1.200em, ASCII 0.600em), so diffs,
          tables and logs stay aligned; <strong class="text-foreground">Qu Black Sans</strong> keeps
          the prose readable next to them.
        </p>

        <div data-cta-row class="mt-[1.4rem] flex flex-wrap items-center gap-[0.6rem]">
          <BGButton tone="glow" href={RELEASE_URL}>Download v{version}</BGButton>
          <BGButton tone="ghost" href="#howto">How to use</BGButton>
        </div>

        <dl
          class="mt-[1.5rem] grid grid-cols-2 gap-px overflow-hidden rounded-[14px] border border-bf-border min-[560px]:grid-cols-4"
        >
          {
            stats.map((stat) => (
              <div class="bg-bf-border-muted/80 px-[0.8rem] py-[0.65rem]">
                <dt class="font-code text-[0.58rem] tracking-[0.08em] text-bf-dim uppercase">
                  {stat.label}
                </dt>
                <dd class="m-0 font-code text-[0.95rem] text-foreground">{stat.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <!-- Two-up: the card is taken out of flow so the left column sets the row height, then the
           card is stretched back to that height and its thread grows into the space. -->
      <div class="relative min-w-0">
        <BGAgentChat />
      </div>
    </div>

    <div
      class="mt-[clamp(1.6rem,4vw,2.6rem)] rounded-[22px] border border-bf-border bg-bf-border-muted/70 p-[clamp(1rem,3vw,2rem)]"
    >
      <div
        class="mb-3 flex flex-wrap items-center justify-between gap-x-3 gap-y-1"
        data-specimen-header
      >
        <!-- The two-word family name costs one more mono cell in the face label, which used to push
             this row past the phone width; below 760px the label tightens its tracking instead of
             wrapping, so the two halves keep one centreline. -->
        <span
          class="font-code text-[0.72rem] tracking-[0.14em] text-bf-fg-muted uppercase max-[760px]:tracking-[0.08em]"
        >
          editable specimen<span class="hidden min-[760px]:inline"
            > — click and type, Enter to commit, Esc to revert</span
          >
        </span>
        <span id="face-label" class="font-code text-[0.72rem] text-bf-blue" aria-live="polite"
          >Qu Black Sans Regular</span
        >
      </div>

      <p
        id="hero-specimen"
        data-specimen
        contenteditable="true"
        spellcheck="false"
        role="textbox"
        aria-label="Editable specimen"
        aria-multiline="false"
        data-specimen-scale
        class="m-0 cursor-text leading-[1.25] font-normal outline-none focus-visible:rounded-lg focus-visible:ring-2 focus-visible:ring-bf-blue/60"
        >黢黑 Qu Black 中英混排 2:1 grid · 字体 specimen</p
      >
      <p
        id="specimen-sample"
        data-specimen
        data-specimen-scale
        class="mt-4 mb-0 leading-[1.6] text-bf-fg-muted"
      >
        汉 a 国 b 图 c 一 d 口 e — the mono face keeps 汉字 twice as wide as ASCII, so code blocks,
        tables and terminal output line up across languages.
      </p>

      <div
        class="mt-6 flex flex-wrap items-center justify-between gap-x-6 gap-y-3"
        role="group"
        aria-label="Specimen controls"
        data-control-strip
      >
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2" data-control-groups>
          <div class="flex items-center gap-2" data-control-group="family">
            <span class="min-w-[3.25rem] font-code text-[0.72rem] text-bf-dim uppercase">family</span>
            <BGButton tone="chip" data-control="family" data-value="sans" aria-pressed="true"
              >Sans</BGButton
            >
            <BGButton tone="chip" data-control="family" data-value="mono" aria-pressed="false"
              >Mono</BGButton
            >
          </div>
          <div class="flex items-center gap-2" data-control-group="weight">
            <span class="min-w-[3.25rem] font-code text-[0.72rem] text-bf-dim uppercase">weight</span>
            <BGButton tone="chip" data-control="weight" data-value="regular" aria-pressed="true"
              >Regular</BGButton
            >
            <BGButton tone="chip" data-control="weight" data-value="bold" aria-pressed="false"
              >Bold</BGButton
            >
          </div>
          <div class="flex items-center gap-2" data-control-group="style">
            <span class="min-w-[3.25rem] font-code text-[0.72rem] text-bf-dim uppercase">style</span>
            <BGButton tone="chip" data-control="italic" data-value="toggle" aria-pressed="false"
              >Italic</BGButton
            >
          </div>
        </div>
        <span class="ml-auto font-code text-[0.7rem] text-bf-dim" data-control-metrics>
          keys: B/L bold · M/N mono · S sans · I italic · ↓↑ sections · 1–8 jump
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  /* The editable specimen keeps one optical size across families: font-size × specimen-scale,
     where the client sets --specimen-scale to 1 (Sans) or 833/1000 (Mono). Only these two lines
     scale — the ASCII table and the 2:1 proof keep the real metrics. */
  #hero-specimen {
    --specimen-size: clamp(1.9rem, 5vw, 3.4rem);
  }
  #specimen-sample {
    --specimen-size: clamp(1rem, 2vw, 1.35rem);
  }
  [data-specimen-scale] {
    font-size: calc(var(--specimen-size) * var(--specimen-scale, 1));
  }
</style>
