---
import type { LookalikeRow } from "../../data/lookalikes.ts";

interface Props {
  row: LookalikeRow;
}
const { row } = Astro.props;
---

{/* Three strict columns — glyphs / annotation / note — so the middle column starts at the same
    x on every row instead of trailing the glyph run. Single column below 900px. */}
<div
  class="lookalike-row grid grid-cols-[minmax(0,1fr)_17rem_minmax(0,1fr)] items-baseline gap-x-5 border-b border-bf-border/60 py-4 last:border-b-0 max-[900px]:grid-cols-1 max-[900px]:items-start max-[900px]:gap-y-2"
  data-lookalike={row.label}
>
  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1" data-specimen data-lookalike-glyphs>
    {
      row.glyphs.map((glyph) => (
        <span class="text-[clamp(1.7rem,4vw,2.6rem)] leading-none text-foreground">{glyph}</span>
      ))
    }
  </div>
  <span class="font-code text-[0.68rem] text-bf-dim" data-testid="lookalike-label">{row.label}</span>
  <p class="m-0 text-[0.85rem] text-bf-fg-muted">{row.note}</p>
</div>
