---
import { cn } from "../../lib/utils.ts";
import { bgCardVariants } from "./card.tsx";

// A download link styled as a small card: arrow tile, file label, one line of detail.
interface Props {
  href: string;
  label: string;
  detail: string;
  class?: string;
}
const { href, label, detail, class: extra = "" } = Astro.props;
---

<a
  class={cn(
    bgCardVariants({ tone: "plate" }),
    "flex items-center gap-[0.8rem] rounded-[14px] px-4 py-[0.8rem] text-foreground no-underline transition-[border-color,transform] duration-250 ease-bf hover:-translate-y-0.5 hover:border-bf-blue/45 hover:text-foreground",
    extra,
  )}
  href={href}
  download
>
  <span class="grid size-[34px] place-items-center rounded-[10px] bg-bf-blue/14 text-[0.95rem] text-bf-blue">↓</span>
  <span>
    <strong class="block font-code text-[0.85rem] font-semibold">{label}</strong>
    <span class="text-[0.75rem] text-bf-dim">{detail}</span>
  </span>
</a>
