---
import BGAsciiTable from "../components/bg/ascii-table.astro";
import BGCoverage from "../components/bg/coverage.astro";
import BGDownload from "../components/bg/download.astro";
import BGGridProof from "../components/bg/grid-proof.astro";
import BGLookalikes from "../components/bg/lookalikes.astro";
import BGSpecimenHero from "../components/bg/specimen-hero.astro";
import BGSpecimenLong from "../components/bg/specimen-long.astro";
import { RELEASE_URL, VERSION } from "../data/site.ts";
import Base from "../layouts/Base.astro";

// Printed verbatim from dist/SHA256SUMS; the release audit (plan/scripts/verify-release.sh)
// recomputes it from the downloaded asset.
const SHA256 = "aa706906f1f608ce43abf03410049a39e6f69e1887532937de2a479f4373834d";
---

<Base
  title="黢黑 QuBlack — a modern font for your agent"
  description="QuBlack renders agent output — English, 中文 and code — on one grid: a measured 2:1 mono cell (汉 1.200em, ASCII 0.600em) plus a proportional sibling. SIL OFL 1.1."
>
  <BGSpecimenHero version={VERSION} releaseUrl={RELEASE_URL} />
  <BGAsciiTable />
  <BGLookalikes />
  <BGGridProof />
  <BGSpecimenLong />
  <BGCoverage />
  <BGDownload sha256={SHA256} />
</Base>
